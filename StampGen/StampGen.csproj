<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Публикация одним exe (запускается двойным кликом, браузер открывается сам).
         Сборка: dotnet publish -c Release -r win-x64 (self-contained, single file) -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Version>2.3.0</Version>
    <FileVersion>2.3.0</FileVersion>
    <InformationalVersion>StampGen v2.3.0 — (c) Guoud, iljamakeev@yandex.ru — коммерческое использование без разрешения запрещено</InformationalVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- v2.2: защита от реверс-инженеринга — в Release не кладём PDB-файлы с отладочными
         символами (без них декомпиляция IL заметно сложнее). Обфускация IL — опционально:
         .\build-exe.ps1 -Obfuscate (см. obfuscar.xml и BUILD-EXE.md). -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

</Project>
